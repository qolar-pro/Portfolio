# QA scripts drive a headless browser against a running dev/prod server.
# They are development tooling and have no business in a deployment.
tools/
.qa/
_embargoed-originals/

# Local secrets. Git already ignores these; this line stops a `vercel deploy`
# from the CLI — which uploads the working directory rather than the commit —
# carrying the webhook credential into a deployment's source.
.env*.local
